{
  "description": [
    "OSS release staging policy for TensorRT Edge-LLM.",
    "DO_NOT_RELEASE removes whole files, directories, and globs from the release staging tree.",
    "{$edge-llm-internal-release begin/end} removes internal regions from otherwise public files.",
    "Release tooling must sanitize a staging tree with scripts/strip_internal_release.py before publishing to GitHub."
  ],
  "release_policy": {
    "do_not_release_manifest": "DO_NOT_RELEASE",
    "guarded_region_markers": {
      "begin": "{$edge-llm-internal-release begin}",
      "end": "{$edge-llm-internal-release end}"
    },
    "delete_paths": [
      "cpp/kernels/multiDeviceKernels/shmAllReduce.cu",
      "cpp/kernels/multiDeviceKernels/shmAllReduce.h",
      "unittests/shmAllReduceTests.cu"
    ],
    "strip_paths": [
      ".dockerignore",
      "cmake/CuteDsl.cmake",
      "kernelSrcs/build_cutedsl.py",
      "kernelSrcs/gemm_cutedsl/gemm_blackwell_nvfp4_ws.py",
      "cpp/kernels/multiDeviceKernels/cuteDslGemmNvFp4Runner.h",
      "cpp/plugins/allReducePlugin/allReducePlugin.cpp",
      "cpp/plugins/allReducePlugin/allReducePlugin.h",
      "cpp/plugins/fusedNvfp4GemmAllReducePlugin/fusedNvfp4GemmAllReducePlugin.cpp",
      "cpp/plugins/fusedNvfp4GemmAllReducePlugin/fusedNvfp4GemmAllReducePlugin.h"
    ],
    "forbidden_patterns": [
      "edge-llm-internal-release",
      "shmAllReduce",
      "ShmAllReduce",
      "EDGELLM_SHM",
      "SuperThor",
      "enableShmAllReduce",
      "shmMaxElements",
      "shmAllReduceElementThreshold",
      "shmFp8SmallPathElementThreshold",
      "shmSessionName"
    ]
  }
}
