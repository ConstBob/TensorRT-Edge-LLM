{
  "description": [
    "OSS release staging policy for TensorRT Edge-LLM.",
    "DO_NOT_RELEASE removes whole files, directories, and globs from the release staging tree.",
    "{$edge-llm-internal-release begin/end} removes internal regions from otherwise public files.",
    "Release tooling must sanitize a staging tree with scripts/strip_internal_release.py before publishing to GitHub."
  ],
  "release_policy": {
    "do_not_release_manifest": "DO_NOT_RELEASE",
    "guarded_region_markers": {
      "begin": "{$edge-llm-internal-release begin}",
      "end": "{$edge-llm-internal-release end}"
    },
    "delete_paths": [
      "cpp/kernels/multiDeviceKernels/shmAllReduce.cu",
      "cpp/kernels/multiDeviceKernels/shmAllReduce.h",
      "cpp/runtime/multiDevice/backends/shm/tensorParallelShmResources.cpp",
      "cpp/runtime/multiDevice/backends/shm/tensorParallelShmResources.h",
      "unittests/shmAllReduceTests.cu"
    ],
    "strip_paths": [
      ".dockerignore",
      "cmake/CuteDsl.cmake",
      "kernelSrcs/build_cutedsl.py",
      "kernelSrcs/gemm_cutedsl/gemm_blackwell_nvfp4_ws.py",
      "cpp/common/allReducePath.h",
      "cpp/kernels/multiDeviceKernels/cuteDslGemmNvFp4Runner.h",
      "cpp/plugins/allReducePlugin/allReducePlugin.cpp",
      "cpp/plugins/allReducePlugin/allReducePlugin.h",
      "cpp/plugins/fusedNvfp4GemmAllReducePlugin/fusedNvfp4GemmAllReducePlugin.cpp",
      "cpp/plugins/fusedNvfp4GemmAllReducePlugin/fusedNvfp4GemmAllReducePlugin.h",
      "cpp/runtime/multiDevice/multiDevicePluginCommRegistry.cpp",
      "cpp/runtime/multiDevice/multiDevicePluginCommRegistry.h",
      "cpp/runtime/multiDevice/multiDevicePluginResourceFactory.cpp",
      "cpp/runtime/multiDevice/multiDevicePluginResourceFactory.h",
      "cpp/runtime/multiDevice/parallelConfig.cpp",
      "cpp/runtime/multiDevice/parallelConfig.h",
      "cpp/runtime/multiDevice/runtimeCoordinator.cpp",
      "cpp/runtime/multiDevice/runtimeCoordinator.h",
      "cpp/runtime/multiDevice/tensorParallelPluginResources.cpp",
      "cpp/runtime/multiDevice/tensorParallelPluginResources.h",
      "docs/source/user_guide/features/multi-device.md",
      "examples/llm/llm_inference.cpp",
      "unittests/parallelConfigTest.cpp"
    ],
    "forbidden_patterns": [
      "edge-llm-internal-release",
      "shmAllReduce",
      "ShmAllReduce",
      "EDGELLM_SHM",
      "SuperThor",
      "pinThreadToNumaNode",
      "enableShmAllReduce",
      "shmMaxElements",
      "shmAllReduceElementThreshold",
      "shmFp8SmallPathElementThreshold",
      "TensorParallelShmResources",
      "syncShmHostBarrier",
      "AllReducePathType::kShm",
      "test_shm_allreduce",
      "gitlab-master.nvidia.com",
      "artifactory.nvidia.com",
      "urm.nvidia.com",
      "cpu-general-k8s",
      "local-spark",
      "-nvks"
    ]
  }
}
